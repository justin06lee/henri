# systemd user unit for henri.
#
# Install:
#   mkdir -p ~/.config/systemd/user
#   cp dist/henri.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now henri
#
# Logs:  journalctl --user -u henri -f
#
# This is a *user* unit on purpose: the clipboard belongs to your graphical
# session, so henri has to run as you, inside that session.

[Unit]
Description=henri - shared clipboard
Documentation=https://github.com/justin06lee/henri
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/henri daemon
Restart=on-failure
RestartSec=5

# The config holds the group key; keep the process from wandering.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.config/henri

[Install]
WantedBy=graphical-session.target
